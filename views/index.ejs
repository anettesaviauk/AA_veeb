<!DOCTYPE html>
<html lang="et">

<head>
    <meta charset="utf-8">
    <title>Anette Saviauk, veebiprogrammeerimine</title>

</head>

<body>
    <img src="images/vp_banner_2025_AA.jpg" alt="Kursuse bänner">
    <h1>Anette Saviauk, veebiprogrammeerimine</h1>
    <p>See leht on loodud <a href="https://www.tlu.ee/">Tallinna Ülikoolis</a> veebiprogrammeerimise kursusel ja ei oma
        mõistlikku sisu.</p>
    <hr>
    <h2>Siin lehel leiad</h2>
    <ul>
        <li><a href="/timenow">Ajainfo</a></li>
        <li><a href="/vanasonad">Valik Eesti tuntud vanasõnu</a></li>
        <li><a href="/regvisit">Registreeri oma külastus</a></li>
        <li><a href="/visitlog">Vaata külastajaid</a></li>
        <li><a href="/eestifilm">Eesti film</a></li>
        <li><a href="/galleryphotoupload">Galeriipiltide üleslaadimine</a></li>
        <li><a href="/photogallery">Fotogalerii</a></li>
        <li><a href="/newsadd">Uudiste lisamine</a></li>
        <li><a href="/newsview">Uudiste vaatamine</a></li>

    </ul>
    <hr>
    <h2>Viimane avalik foto</h2>

    <% if (lastphoto) { %>
        <img src="/gallery/normal/<%= lastphoto.filename %>" alt="<%= lastphoto.alttext %>" style="max-width: 400px;">
        <% } else { %>
            <p>Ühtegi avalikku fotot pole veel lisatud.</p>
            <% } %>


                <hr>
                <h2>Värskeim uudis</h2>

                <% if (latestNews) { %>
                    <h3>
                        <%= latestNews.title %>
                    </h3>
                    <p>
                        <%= latestNews.content %>
                    </p>

                    <% if (latestNews.photofilename) { %>
                        <img src="/news/orig/<%= latestNews.photofilename %>" alt="<%= latestNews.alttext %>"
                            width="400">
                        <% } %>

                            <% } else { %>
                                <p>Hetkel ükski uudis ei ole saadaval.</p>
                                <% } %>

</body>

</html>